{
  "name": "mailgatewayid/laravel",
  "description": "Laravel mail transport for MailGateway.id (MAIL_MAILER=mailgateway)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "mailgatewayid/php": "^0.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/mail": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": { "psr-4": { "MailGateway\\Laravel\\": "src/" } },
  "extra": { "laravel": { "providers": ["MailGateway\\Laravel\\MailGatewayServiceProvider"] } }
}
